# Copy this file to .env (PowerShell: Copy-Item .env.example .env) and edit if needed.

# --- Database (docker-compose publishes Postgres on 5434) ---
# Use 127.0.0.1, not "localhost": on Windows "localhost" resolves to IPv6 ::1 first, Docker only
# publishes the ports on IPv4, and every new connection would stall until the IPv6 attempt times out.
DATABASE_URL=postgresql://ergosense:ergosense@127.0.0.1:5434/ergosense

# --- MQTT broker ---
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# --- Strain model ---
# Safe cumulative strain per worker per shift (strain points, see docs on the strain rule).
STRAIN_THRESHOLD=400

# --- Backend ---
API_HOST=127.0.0.1
API_PORT=8000

# --- LLM for the safety report ---
# auto   = try Ollama, then the OpenAI-compatible API (if a key is set), then the template fallback
# ollama | openai | none (none = always use the template fallback)
LLM_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# Any OpenAI-compatible endpoint works (OpenAI, Groq, Together, LM Studio, vLLM ...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=180

# --- RAG ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4
